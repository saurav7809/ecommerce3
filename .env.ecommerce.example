# Copy these settings into your shell environment before starting the backend.
DATABASE_URL=jdbc:postgresql://localhost:5432/homenest
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=local-development-secret-change-this-to-a-long-random-value-1234567890
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations; server-side secrets must never be placed in frontend/.env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional account-security providers. For local OTP flows, keep console delivery enabled
# and read codes from the backend terminal. In production, disable it and configure SMTP/SMS.
GOOGLE_CLIENT_ID=
OTP_CONSOLE_DELIVERY=true
OTP_EXPIRATION_MINUTES=10
OTP_EMAIL_FROM=no-reply@homenest.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_SMS_GATEWAY_URL=
OTP_SMS_GATEWAY_TOKEN=
