# Local demo defaults (change passwords and JWT_SECRET before any deployment)
DATABASE_PASSWORD=store-local-only
JWT_SECRET=local-development-secret-change-this-to-a-long-random-value-1234567890

# Optional integrations; server-side secrets must never be placed in frontend/.env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
