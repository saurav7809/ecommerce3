{
  "info": {
    "name": "HomeNest Wayfair-Style Platform API",
    "description": "Enterprise-grade REST API collection for HomeNest e-commerce platform built with Spring Boot 3, Java 21, PostgreSQL, and FastAPI AI Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "aiUrl", "value": "http://localhost:8001" },
    { "key": "token", "value": "" },
    { "key": "otpCode", "value": "" },
    { "key": "phoneCode", "value": "" },
    { "key": "googleIdToken", "value": "" },
    { "key": "orderReference", "value": "ORD-123456" },
    { "key": "productSlug", "value": "haven-velvet-3-piece-sectional" }
  ],
  "item": [
    {
      "name": "01. Health & OpenApi",
      "item": [
        { "name": "API Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
        { "name": "Swagger UI", "request": { "method": "GET", "url": "{{baseUrl}}/swagger-ui.html" } },
        { "name": "OpenAPI JSON Spec", "request": { "method": "GET", "url": "{{baseUrl}}/v3/api-docs" } }
      ]
    },
    {
      "name": "02. Categories & Navigation",
      "item": [
        { "name": "Department Tree (MegaMenu)", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/tree" } },
        { "name": "Category Details by Slug", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/furniture" } }
      ]
    },
    {
      "name": "03. Products & Faceted Search",
      "item": [
        { "name": "Search & Filter Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?query=sofa&category=furniture&sort=recommended&page=0&size=16" } },
        { "name": "Product Facets Counts", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/facets?category=furniture" } },
        { "name": "Product Details by Slug", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productSlug}}" } },
        { "name": "Similar Products (Complete the Look)", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1/similar?limit=4" } }
      ]
    },
    {
      "name": "04. Cart & Pricing",
      "item": [
        {
          "name": "Calculate Cart Quote & Shipping",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 },\n    { \"productId\": 2, \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/cart/quote"
          }
        }
      ]
    },
    {
      "name": "05. Authentication",
      "item": [
        {
          "name": "Register Customer / Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Saurav Customer\",\n  \"email\": \"customer.test@example.com\",\n  \"password\": \"SecurePass@123\",\n  \"phone\": \"9876543210\",\n  \"accountType\": \"CUSTOMER\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Request Email Verification Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.test@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/email-verification/request"
          }
        },
        {
          "name": "Verify Email (use code from backend console)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.test@example.com\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/email-verification/verify"
          }
        },
        {
          "name": "Google Sign In (set a Google ID token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/google"
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homenest.local\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@homenest.local\",\n  \"password\": \"Customer@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "******" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Saurav Customer\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Request Phone Verification Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/phone-verification/request"
          }
        },
        {
          "name": "Verify Phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{phoneCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/phone-verification/verify"
          }
        },
        {
          "name": "Request Password Reset Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.test@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password-reset/request"
          }
        },
        {
          "name": "Reset Password (use code from backend console)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.test@example.com\",\n  \"code\": \"{{otpCode}}\",\n  \"newPassword\": \"NewSecurePass@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password-reset"
          }
        }
      ]
    },
    {
      "name": "06. Orders & Checkout",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Saurav Sharma\",\n    \"street\": \"42 Indiranagar 100ft Road\",\n    \"apartment\": \"Apt 302\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560038\",\n    \"country\": \"IN\",\n    \"phone\": \"9876543210\"\n  },\n  \"paymentMethod\": \"RAZORPAY\",\n  \"saveAddress\": true\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders?page=0&size=10"
          }
        },
        {
          "name": "Get Order By Reference",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders/{{orderReference}}"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders/{{orderReference}}/cancel"
          }
        }
      ]
    },
    {
      "name": "07. Razorpay Payments",
      "item": [
        { "name": "Payment Gateway Configuration", "request": { "method": "GET", "url": "{{baseUrl}}/api/payment/config" } },
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderReference\": \"{{orderReference}}\"\n}"
            },
            "url": "{{baseUrl}}/api/payment/razorpay/order"
          }
        },
        {
          "name": "Verify Razorpay Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderReference\": \"{{orderReference}}\",\n  \"razorpayOrderId\": \"order_test_123\",\n  \"razorpayPaymentId\": \"pay_test_123\",\n  \"razorpaySignature\": \"test_sig\"\n}"
            },
            "url": "{{baseUrl}}/api/payment/razorpay/verify"
          }
        }
      ]
    },
    {
      "name": "08. Reviews & Ratings",
      "item": [
        { "name": "List Product Reviews", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1/reviews?page=0&size=10" } },
        { "name": "Product Review Statistics", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1/reviews/stats" } },
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"title\": \"Spectacular quality and craftsmanship\",\n  \"comment\": \"The velvet feels ultra plush and the solid walnut legs are sturdy and gorgeous.\"\n}"
            },
            "url": "{{baseUrl}}/api/products/1/reviews"
          }
        }
      ]
    },
    {
      "name": "09. Admin & Merchant Operations",
      "item": [
        {
          "name": "Admin Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/stats"
          }
        },
        {
          "name": "Admin Orders List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/orders?page=0&size=20"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\",\n  \"notes\": \"Dispatched with BlueDart Express #BLU-88273\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/orders/{{orderReference}}/status"
          }
        },
        {
          "name": "List Managed Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/manage/products?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "10. AI Services (Python FastAPI)",
      "item": [
        { "name": "AI Service Health", "request": { "method": "GET", "url": "{{aiUrl}}/health" } },
        {
          "name": "AI Interior Design Assistant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I want to furnish a Scandinavian living room with under 35000 budget\",\n  \"history\": []\n}"
            },
            "url": "{{aiUrl}}/api/assistant"
          }
        },
        {
          "name": "AI Cart Recommendations",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_ids\": [1, 3],\n  \"limit\": 4\n}"
            },
            "url": "{{aiUrl}}/api/recommendations"
          }
        }
      ]
    }
  ]
}
